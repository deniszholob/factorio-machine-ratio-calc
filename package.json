{
  "name": "factorio-machine-ratio-calc",
  "version": "0.0.0",
  "license": "GPL-3",
  "author": "Denis Zholob",
  "description": "Factorio Machine Ratio calc",
  "repository": "github:factorio-machine-ratio-calc",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">= 22.16.0",
    "npm": ">= 11.4.2"
  },
  "scripts": {
    "i": "pnpm i",
    "storybook": "nx run factorio-machine-ratio-calc:storybook --no-open",
    "storybook:moke-test": "pnpm run storybook -- --ci --smoke-test",
    "start": "WATCHPACK_POLLING=true nx serve --port=4985",
    "reset": "nx reset",
    "build:updateBuildInfo": "node .github/ci/update-build-info.js",
    "build:discardPatch": "git restore src/index.html src/app/app.build.ts",
    "build:patchBuildInfo": "pnpm run build:discardPatch && pnpm run build:updateBuildInfo",
    "build": "nx build",
    "build:gh-prod": "pnpm run build:patchBuildInfo && nx build factorio-machine-ratio-calc --base-href ./ && cp dist/index.html dist/404.html",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "lint:err": "nx lint --quiet",
    "format:fix": "nx format:write",
    "format:check": "nx format:check",
    "format": "prettier --write .",
    "format:nl": "prettier --end-of-line lf --write .",
    "test": "nx test --codeCoverage",
    "test:view-coverage": "cd coverage/factorio-machine-ratio-calc && index.html",
    "storybook:doctor": "pnpx storybook doctor --config-dir './.storybook'",
    "upgrade:clean-cache": "rm -rf .nx",
    "upgrade:nx:create-latest": "pnpx nx@latest migrate 22",
    "upgrade:nx:install": "pnpm install --no-frozen-lockfile",
    "upgrade:nx:apply": "nx migrate --run-migrations",
    "upgrade:tailwind": "pnpx @tailwindcss/upgrade",
    "upgrade:storybook": "pnpx storybook@9.0.15 upgrade --config-dir ./.storybook",
    "upgrade:storybook-auto": "pnpx storybook@9.0.15 automigrate --config-dir ./.storybook",
    "nx": "nx"
  },
  "dependencies": {
    "@angular/animations": "21.1.3",
    "@angular/cdk": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/platform-browser": "21.1.3",
    "@angular/platform-browser-dynamic": "21.1.3",
    "@angular/router": "21.1.3",
    "@ng-select/ng-select": "21.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.1.3",
    "@angular-devkit/core": "21.1.3",
    "@angular-devkit/schematics": "21.1.3",
    "@angular-eslint/eslint-plugin": "21.2.0",
    "@angular-eslint/eslint-plugin-template": "21.2.0",
    "@angular-eslint/template-parser": "21.2.0",
    "@angular/cli": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/language-service": "21.1.3",
    "@nx/angular": "22.4.5",
    "@nx/devkit": "22.4.5",
    "@nx/eslint": "22.4.5",
    "@nx/eslint-plugin": "22.4.5",
    "@nx/jest": "22.4.5",
    "@nx/js": "22.4.5",
    "@nx/storybook": "22.4.5",
    "@nx/vite": "22.4.5",
    "@nx/vitest": "22.4.5",
    "@nx/web": "22.4.5",
    "@nx/workspace": "22.4.5",
    "@schematics/angular": "21.1.3",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/angular": "10.2.8",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.99",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/utils": "^7.16.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.2.8",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-preset-angular": "16.0.0",
    "jest-util": "^30.0.0",
    "jiti": "2.4.2",
    "nx": "22.4.5",
    "postcss": "^8.4.5",
    "prettier": "3.8.1",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "10.2.8",
    "tailwindcss": "^4.1.18",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.1",
    "typescript": "5.9.3"
  }
}
