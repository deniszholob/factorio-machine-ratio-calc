{
  "name": "factorio-machine-ratio-calc",
  "version": "0.0.0",
  "license": "GPL-3",
  "author": "Denis Zholob",
  "description": "Factorio Machine Ratio calc",
  "repository": "github:factorio-machine-ratio-calc",
  "private": true,
  "scripts": {
    "i": "pnpm i",
    "storybook": "nx run factorio-machine-ratio-calc:storybook",
    "reset": "nx reset",
    "start": "nx serve --port=4985",
    "build": "nx build",
    "build:prod": "nx build factorio-machine-ratio-calc --base-href ./",
    "build:sh": "sh ./.github/build/build.sh",
    "build:date": "sh ./.github/build/update-date.sh`",
    "lint": "nx lint",
    "lint:fix": "nx lint --fix",
    "lint:err": "nx lint --quiet",
    "format:fix": "nx format:write",
    "format:check": "nx format:check",
    "format": "prettier --write .",
    "format:nl": "prettier --end-of-line lf --write .",
    "test": "nx test --codeCoverage",
    "test:view-coverage": "cd coverage/factorio-machine-ratio-calc && index.html",
    "storybook:doctor": "pnpx storybook doctor --config-dir 'apps/web/.storybook'",
    "upgrade:clean-cache": "rm -rf .nx",
    "upgrade:nx:create-latest": "pnpx nx@latest migrate 17",
    "upgrade:nx:install": "pnpm install --no-frozen-lockfile",
    "upgrade:nx:apply": "nx migrate --run-migrations",
    "upgrade:storybook": "pnpx storybook@9.0.15 upgrade --config-dir ./.storybook",
    "upgrade:storybook-auto": "pnpx storybook@9.0.15 automigrate --config-dir ./.storybook",
    "nx": "nx"
  },
  "dependencies": {
    "@angular/animations": "17.1.3",
    "@angular/cdk": "17.1.2",
    "@angular/common": "17.1.3",
    "@angular/compiler": "17.1.3",
    "@angular/core": "17.1.3",
    "@angular/forms": "17.1.3",
    "@angular/platform-browser": "17.1.3",
    "@angular/platform-browser-dynamic": "17.1.3",
    "@angular/router": "17.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "0.14.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.1.4",
    "@angular-devkit/core": "17.1.4",
    "@angular-devkit/schematics": "17.1.4",
    "@angular-eslint/eslint-plugin": "17.0.1",
    "@angular-eslint/eslint-plugin-template": "17.0.1",
    "@angular-eslint/template-parser": "17.0.1",
    "@angular/cli": "~17.1.0",
    "@angular/compiler-cli": "17.1.3",
    "@angular/language-service": "17.1.3",
    "@nx/angular": "17.3.2",
    "@nx/devkit": "17.3.2",
    "@nx/eslint": "17.3.2",
    "@nx/eslint-plugin": "17.3.2",
    "@nx/jest": "17.3.2",
    "@nx/js": "17.3.2",
    "@nx/storybook": "17.3.2",
    "@nx/vite": "17.3.2",
    "@nx/web": "17.3.2",
    "@nx/workspace": "17.3.2",
    "@schematics/angular": "17.1.4",
    "@storybook/addon-essentials": "7.6.9",
    "@storybook/angular": "7.6.9",
    "@storybook/core-common": "^7.0.9",
    "@storybook/core-server": "7.6.9",
    "@tailwindcss/forms": "^0.5.3",
    "@types/jest": "^29.4.0",
    "@types/node": "18.19.99",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "autoprefixer": "^10.4.0",
    "eslint": "~8.15.0",
    "eslint-config-prettier": "8.1.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-preset-angular": "13.1.6",
    "nx": "17.3.2",
    "postcss": "^8.4.5",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.0.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "5.3.3"
  }
}
